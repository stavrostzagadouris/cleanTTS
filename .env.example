# Copy this to `.env` and fill in your own values. `.env` is gitignored.

# JSON list of LLM backends. Each entry needs a name (shown in the UI dropdown)
# and a URL pointing at any OpenAI-compatible /v1 endpoint (vLLM, LM Studio, Ollama, etc.).
#
# Optional per-backend "chat_template_kwargs" is forwarded into every chat
# completion request. Use this to disable Qwen3 thinking for THIS app only —
# other clients hitting the same backend are unaffected since the kwarg is
# per-request:
#   {"name":"...","url":"...","chat_template_kwargs":{"enable_thinking":false}}
LLM_BACKENDS=[{"name":"server-a","url":"http://100.x.y.z:1234/v1","chat_template_kwargs":{"enable_thinking":false}},{"name":"server-b","url":"http://100.x.y.z:1234/v1"}]

# Single-backend fallback (used only if LLM_BACKENDS is unset or invalid)
# LLM_BASE_URL=http://localhost:1234/v1

# Local Whisper (STT)
# WHISPER_DEVICE: 'auto' picks cuda > mps > cpu. faster-whisper has no MPS
# backend, so on Apple Silicon it auto-downgrades to cpu (with int8). On a
# CUDA box, leave 'auto' or set 'cuda' explicitly.
WHISPER_MODEL=distil-large-v3                  # or 'small', 'medium', etc.
WHISPER_DEVICE=auto                            # auto | cuda | cpu
# WHISPER_BEAM_SIZE=5                          # 1 = greedy, ~2x faster STT with near-identical quality on distil models
# Silero VAD pre-pass, on by default. Without it faster-whisper reports every
# segment as starting at 0.00 when a clip has leading silence (measured up to
# 20s off) and invents a phrase out of speech-free audio ("you", "Thank you.").
# With it, onsets land within 0.1s, speech-free audio returns no segments, real
# speech survives down to at least -50dB, and it costs ~7ms per request.
# Set false to restore the old behaviour; /v1/audio/transcriptions also takes a
# per-request vad_filter form field.
WHISPER_VAD_FILTER=true

# Parakeet STT (NVIDIA FastConformer-TDT via MLX) — a second STT engine.
# Unlike faster-whisper/CTranslate2, MLX runs on Metal, so this is the only STT
# option here that uses the GPU. Measured on an M1 Max, 5s clip: 0.14s vs 0.66s
# for distil-small.en and 5.15s for large-v3-turbo; 76x realtime vs 30x and 4.7x.
# Select per request with model=parakeet, or make it the default with STT_MODEL.
# PARAKEET_MODEL=mlx-community/parakeet-tdt-0.6b-v3

# Model used when a request names none, and by the /ws voice pipeline.
# Defaults to WHISPER_MODEL. Set to "parakeet" to move /ws onto MLX — measured
# 0.44s earlier first-audio per turn. Trade-offs before you flip it:
#  - Parakeet has no no_speech_prob and ignores `prompt`; it reports a native
#    `confidence` per segment instead (hallucination ~0.78, real speech >0.96).
#  - It is 25 European languages with auto-detect, vs distil-small.en English-only.
#  - It does not hallucinate on silence, but CAN on some noise (see README).
# STT_MODEL=parakeet

# Kokoro TTS
# Comma-separated lang_codes; one KPipeline is loaded per language. Each
# pipeline is ~300MB VRAM (less on CPU/MPS). Pick a voice id that matches
# one of the loaded languages (voice prefix = lang_code, e.g. "bf_emma" needs "b").
#   a=American English  b=British English   j=Japanese   z=Mandarin
#   e=Spanish           f=French            h=Hindi      i=Italian   p=Brazilian Portuguese
KOKORO_LANGS=a,b
KOKORO_DEVICE=auto                             # auto | cuda | mps | cpu
DEFAULT_VOICE=af_bella

# Speaker diarization (pyannote) — POST /v1/audio/diarize
# Unlike faster-whisper, pyannote is plain PyTorch and DOES run on MPS, so on
# Apple Silicon 'auto' resolves to mps — the one stage this hardware really
# accelerates. The pipeline loads lazily on the first diarize request, not at
# startup, so it costs nothing until used.
#
# The default model is GATED. HF_TOKEN must belong to an account that has
# accepted the terms at huggingface.co/pyannote/speaker-diarization-community-1
# — without that, pyannote returns no pipeline and the route answers 503.
# If HF_TOKEN is unset, a `huggingface-cli login` token is used if cached.
# HF_TOKEN=hf_...
DIARIZE_DEVICE=auto                            # auto | cuda | mps | cpu
# DIARIZE_MODEL=pyannote/speaker-diarization-community-1
# If an op is missing from the MPS backend, uncomment to fall back to CPU
# per-op instead of erroring:
# PYTORCH_ENABLE_MPS_FALLBACK=1

# Voice assistant system prompt
SYSTEM_PROMPT=You are a helpful, concise voice assistant. Replies are spoken aloud, so keep them short and natural for speech (no markdown, no bullet lists, no headers). Input is transcribed from the user's voice and may contain occasional mis-heard words or odd artifacts — if something looks like a transcription glitch, infer what they likely meant when context makes it obvious, otherwise ask a brief clarifying question rather than answering the literal nonsense.

# Server
# HOST=0.0.0.0 binds every interface. Only do that if this machine is behind a
# NAT or firewall: cleanTTS has no authentication and proxies to your LLM
# backends, so on a box with a publicly routable address it would be exposed to
# the internet. Binding a single private/VPN address (e.g. this host's
# Tailscale IP) is safer — but note uvicorn binds exactly ONE address, so
# localhost:5000 then stops resolving and local clients must use that IP too.
# If the address belongs to an interface that appears late at login (Tailscale),
# the bind fails until it exists; under launchd KeepAlive it retries and
# self-heals, at the cost of one model load per attempt.
HOST=0.0.0.0
PORT=5000
